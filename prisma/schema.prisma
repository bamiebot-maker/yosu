// YOSU Enterprise Database Schema (v2.1 Enterprise Optimized)
// Compatible with SQLite (Local Dev) & PostgreSQL (Production)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS FOR STRICT DATA INTEGRITY
// ==========================================

enum RoleCode {
  SUPER_ADMIN
  ADMIN
  PRESIDENT
  VICE_PRESIDENT
  SECRETARY_GENERAL
  PUBLISHER
  EDITOR
  TREASURER
  AUDITOR
  EXECUTIVE_MEMBER
  LEGISLATIVE_MEMBER
  MODERATOR
  GUEST_ADMIN
  MEMBER
}

enum PermissionCategory {
  NEWS
  GOVERNANCE
  USERS
  PROJECTS
  SYSTEM
  CONSTITUTION
}

enum OfficeCategory {
  EXECUTIVE_COUNCIL
  PRINCIPAL_OFFICER_HOUSE
  HOUSE_REPRESENTATIVE
  CRC_MEMBER
  NSC_MEMBER
  PATRON
  TRADITIONAL_TITLE
}

enum AppointmentStatus {
  ACTIVE
  COMPLETED
  RESIGNED
  REMOVED
}

enum CommitteeRole {
  CHAIRPERSON
  SECRETARY
  MEMBER
}

enum ArticleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum ResourceCategory {
  Gazette
  Form
  Report
  Constitution
  Academic
}

enum SettingGroup {
  GENERAL
  HERO
  FOOTER
  SEO
  CONTACT
  ANALYTICS
}

// ==========================================
// 1. RBAC & IDENTITY MANAGEMENT
// ==========================================

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  passwordHash  String
  isActive      Boolean         @default(true)
  personId      String?         @unique
  person        Person?         @relation(fields: [personId], references: [id], onDelete: SetNull)
  userRoles     UserRole[]
  auditLogs     AuditLog[]
  publishedNews NewsArticle[]   @relation("AuthorArticles")
  projectUpdates ProjectUpdate[]
  createdMedia  Media[]         @relation("UploadedMedia")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  @@index([email])
  @@index([isActive])
}

model Role {
  id          String           @id @default(cuid())
  code        RoleCode         @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  userRoles   UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String             @id @default(cuid())
  code        String             @unique
  name        String
  category    PermissionCategory
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// ==========================================
// 2. CENTRALIZED MEDIA LIBRARY
// ==========================================

model Media {
  id           String             @id @default(cuid())
  filename     String
  url          String
  publicId     String?
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  altText      String?
  uploadedById String?
  uploadedBy   User?              @relation("UploadedMedia", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  
  personAvatars    Person[]               @relation("PersonAvatar")
  newsFeatured     NewsArticle[]          @relation("NewsFeaturedImage")
  eventsBanners    Event[]                @relation("EventBanner")
  projectImages    Project[]              @relation("ProjectFeaturedImage")
  galleryItems     AlbumMedia[]
  albumCovers      Album[]                @relation("AlbumCover")
  downloadFiles    DownloadResource[]     @relation("DownloadFile")
  constitutionPdfs ConstitutionVersion[]  @relation("ConstitutionPdf")

  @@index([mimeType])
  @@index([uploadedById])
}

// ==========================================
// 3. PERSON & LEADERSHIP GOVERNANCE
// ==========================================

model Person {
  id                   String                 @id @default(cuid())
  fullName             String
  email                String?                @unique
  phoneNumber          String?
  matricNumber         String?                @unique
  stateOfOrigin        String                 // 8 Constituent Yoruba States
  department           String?
  level                String?
  bio                  String?
  avatarMediaId        String?
  avatarMedia          Media?                 @relation("PersonAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  twitterUrl           String?
  linkedinUrl          String?
  instagramUrl         String?
  
  user                 User?
  appointments         OfficeAppointment[]
  committeeMemberships CommitteeMember[]
  memberProfile        MemberProfile?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?

  @@index([stateOfOrigin])
  @@index([fullName])
}

model AdministrationSession {
  id            String                @id @default(cuid())
  title         String                @unique // e.g. "2026/2027 Session"
  slug          String                @unique // e.g. "2026-2027"
  startDate     DateTime
  endDate       DateTime?
  isCurrent     Boolean               @default(false)
  theme         String?
  appointments  OfficeAppointment[]
  committees    Committee[]
  albums        Album[]
  constitutions ConstitutionVersion[]
  projects              Project[]
  achievements          SessionAchievement[]
  dynamicAchievements   Achievement[]
  houseRepresentatives  HouseRepresentative[]
  presidentialWelcomes  PresidentialWelcome[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([isCurrent])
}

model SessionAchievement {
  id           String                @id @default(cuid())
  sessionId    String
  session      AdministrationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title        String
  description  String
  category     String?               // e.g. "LEGISLATION", "ACADEMIC", "WELFARE", "CULTURE"
  date         DateTime?
  displayOrder Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([sessionId])
}

model Office {
  id           String              @id @default(cuid())
  title        String
  category     OfficeCategory
  defaultOrder Int                 @default(0)
  description  String?
  appointments OfficeAppointment[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([category])
}

model OfficeAppointment {
  id               String                @id @default(cuid())
  personId         String
  officeId         String
  sessionId        String
  person           Person                @relation(fields: [personId], references: [id], onDelete: Cascade)
  office           Office                @relation(fields: [officeId], references: [id], onDelete: Cascade)
  session          AdministrationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stateRepresented String?
  appointedAt      DateTime              @default(now())
  endedAt          DateTime?
  status           AppointmentStatus     @default(ACTIVE)
  displayOrder     Int                   @default(0)
  
  @@unique([officeId, sessionId, personId])
  @@index([sessionId, status, displayOrder])
  @@index([personId])
}

// ==========================================
// 4. ORGANIZATIONAL UNITS
// ==========================================

model Department {
  id           String   @id @default(cuid())
  name         String   @unique
  code         String   @unique
  description  String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Committee {
  id          String                @id @default(cuid())
  name        String
  code        String
  description String?
  sessionId   String
  session     AdministrationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  isPermanent Boolean               @default(false)
  members     CommitteeMember[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([sessionId])
}

model CommitteeMember {
  id          String        @id @default(cuid())
  committeeId String
  personId    String
  role        CommitteeRole @default(MEMBER)
  committee   Committee     @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  person      Person        @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([committeeId, personId])
}

// ==========================================
// 5. NEWSROOM SYSTEM
// ==========================================

model NewsArticle {
  id                 String        @id @default(cuid())
  title              String
  slug               String        @unique
  summary            String?
  content            String
  readingTimeMinutes Int           @default(3)
  viewCount          Int           @default(0)
  likeCount          Int           @default(0)
  shareCount         Int           @default(0)
  isFeatured         Boolean       @default(false)
  status             ArticleStatus @default(DRAFT)
  publishedAt        DateTime?
  scheduledFor       DateTime?
  
  featuredMediaId    String?
  featuredMedia      Media?        @relation("NewsFeaturedImage", fields: [featuredMediaId], references: [id], onDelete: SetNull)
  authorId           String
  author             User          @relation("AuthorArticles", fields: [authorId], references: [id], onDelete: Restrict)
  categoryId         String
  category           NewsCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  
  metaTitle          String?
  metaDescription    String?
  canonicalUrl       String?
  
  tags               NewsTag[]     @relation("ArticleTags")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  @@index([status, publishedAt])
  @@index([isFeatured])
  @@index([categoryId])
  @@index([authorId])
}

model NewsCategory {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  description String?
  articles    NewsArticle[]
}

model NewsTag {
  id       String        @id @default(cuid())
  name     String        @unique
  slug     String        @unique
  articles NewsArticle[] @relation("ArticleTags")
}

// ==========================================
// 6. PROJECTS & TRANSPARENCY MODULE
// ==========================================

model Project {
  id                   String                 @id @default(cuid())
  title                String
  slug                 String                 @unique
  summary              String?
  description          String
  status               ProjectStatus          @default(PLANNED)
  startDate            DateTime?
  targetCompletionDate DateTime?
  actualCompletionDate DateTime?
  budgetAmount         Float?
  spentAmount          Float?
  progressPercentage   Int                    @default(0)
  sessionId            String?
  session              AdministrationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  
  featuredMediaId      String?
  featuredMedia        Media?                 @relation("ProjectFeaturedImage", fields: [featuredMediaId], references: [id], onDelete: SetNull)
  milestones           ProjectMilestone[]
  updates              ProjectUpdate[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([status])
  @@index([sessionId])
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  isCompleted Boolean   @default(false)
  order       Int       @default(0)

  @@index([projectId, order])
}

model ProjectUpdate {
  id          String   @id @default(cuid())
  projectId   String
  authorId    String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  title       String
  content     String
  publishedAt DateTime @default(now())

  @@index([projectId, publishedAt])
}

// ==========================================
// 7. EVENTS & CALENDAR
// ==========================================

model Event {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  description   String
  location      String
  startDate     DateTime
  endDate       DateTime?
  isFeatured    Boolean   @default(false)
  bannerMediaId String?
  bannerMedia   Media?    @relation("EventBanner", fields: [bannerMediaId], references: [id], onDelete: SetNull)
  organizer     String?   @default("Executive Council")
  albums        Album[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([startDate])
  @@index([isFeatured])
}

// ==========================================
// 8. GALLERY & ALBUMS
// ==========================================

model Album {
  id           String                 @id @default(cuid())
  title        String
  slug         String                 @unique
  description  String?
  coverMediaId String?
  coverMedia   Media?                 @relation("AlbumCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  eventId      String?
  event        Event?                 @relation(fields: [eventId], references: [id], onDelete: SetNull)
  sessionId    String?
  session      AdministrationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  isPublic     Boolean                @default(true)
  mediaItems   AlbumMedia[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([slug])
  @@index([sessionId])
}

model AlbumMedia {
  id           String   @id @default(cuid())
  albumId      String
  mediaId      String
  caption      String?
  displayOrder Int      @default(0)
  album        Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  media        Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([albumId, mediaId])
}

// ==========================================
// 9. CONSTITUTION ARCHITECTURE & VERSIONING
// ==========================================

model ConstitutionVersion {
  id               String                  @id @default(cuid())
  versionName      String
  edition          String?                 @default("1st Harmonized Edition")
  sessionId        String
  session          AdministrationSession   @relation(fields: [sessionId], references: [id])
  effectiveDate    DateTime
  adoptionDate     DateTime?
  ratificationDate DateTime?
  isCurrent        Boolean                 @default(false)
  assentDate       DateTime?
  assentedBy       String?
  speakerCertBy    String?
  pdfMediaId       String?
  pdfMedia         Media?                  @relation("ConstitutionPdf", fields: [pdfMediaId], references: [id], onDelete: SetNull)
  viewsCount       Int                     @default(0)
  downloadsCount   Int                     @default(0)
  articles         ConstitutionArticle[]
  amendments       ConstitutionAmendment[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([isCurrent])
}

model ConstitutionArticle {
  id            String                @id @default(cuid())
  versionId     String
  version       ConstitutionVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  articleNumber Int
  title         String
  slug          String                @unique
  overview      String?
  sections      ConstitutionSection[]
  createdAt     DateTime              @default(now())

  @@unique([versionId, articleNumber])
  @@index([versionId])
}

model ConstitutionSection {
  id            String              @id @default(cuid())
  articleId     String
  article       ConstitutionArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  sectionNumber String
  title         String
  content       String
  subsections   String?
  displayOrder  Int                 @default(0)

  @@index([articleId, displayOrder])
}

model ConstitutionAmendment {
  id               String              @id @default(cuid())
  versionId        String
  version          ConstitutionVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  articleId        String?
  proposedBy       String
  dateProposed     DateTime
  dateRatified     DateTime?
  amendmentSummary String
  fullText         String
  createdAt        DateTime            @default(now())

  @@index([versionId])
}

// ==========================================
// 10. DOWNLOADS & RESOURCES
// ==========================================

model DownloadResource {
  id             String           @id @default(cuid())
  title          String
  description    String?
  category       ResourceCategory @default(Gazette)
  fileMediaId    String
  fileMedia      Media            @relation("DownloadFile", fields: [fileMediaId], references: [id], onDelete: Cascade)
  downloadsCount Int              @default(0)
  isPublic       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([category, isPublic])
}

// ==========================================
// 11. SITE SETTINGS & FEATURE FLAGS
// ==========================================

model SiteSetting {
  id          String       @id @default(cuid())
  key         String       @unique
  value       String
  group       SettingGroup @default(GENERAL)
  label       String
  description String?
  updatedAt   DateTime     @updatedAt

  @@index([group])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(false)
  category    String   @default("PORTAL")
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// ==========================================
// 12. PAGE BUILDER & CONTENT BLOCKS
// ==========================================

model Page {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean     @default(true)
  blocks          PageBlock[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model PageBlock {
  id           String   @id @default(cuid())
  pageId       String
  page         Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  blockType    String
  content      String
  displayOrder Int      @default(0)
  isVisible    Boolean  @default(true)

  @@index([pageId, displayOrder])
}

// ==========================================
// 13. ANALYTICS & AUDIT LOGGING
// ==========================================

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventType   String
  entityType  String?
  entityId    String?
  path        String
  ipHash      String?
  userAgent   String?
  timestamp   DateTime @default(now())

  @@index([eventType, timestamp])
  @@index([path])
}

model DailyMetric {
  id          String   @id @default(cuid())
  date        DateTime
  metricName  String
  metricValue Int
  dimensions  String?

  @@unique([date, metricName])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}

// ==========================================
// 14. MEMBER PORTAL
// ==========================================

model MemberProfile {
  id               String    @id @default(cuid())
  personId         String    @unique
  person           Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  digitalIdCard    String    @unique
  membershipStatus String    @default("ACTIVE")
  verifiedAt       DateTime?
  graduationYear   Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([membershipStatus])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String
  type        String    @default("INFO") // INFO, URGENT, EVENT, MARQUEE
  isPinned    Boolean   @default(false)
  isActive    Boolean   @default(true)
  startDate   DateTime?
  expiryDate  DateTime?
  linkUrl     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, isPinned])
}

// ==========================================
// 15. DYNAMIC CMS: REPRESENTATIVES & ACHIEVEMENTS
// ==========================================

model HouseRepresentative {
  id            String                @id @default(cuid())
  fullName      String
  stateOfOrigin String
  positionTitle String                @default("Representative")
  photoUrl      String?
  sessionId     String
  session       AdministrationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  displayOrder  Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([sessionId, stateOfOrigin])
}

model Achievement {
  id                 String                @id @default(cuid())
  title              String
  description        String
  progressPercentage Int                   @default(0)
  status             String                @default("ONGOING") // ONGOING, COMPLETED, UPCOMING
  imageUrl           String?
  sessionId          String
  session            AdministrationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([sessionId, status])
}

// ==========================================
// 16. DYNAMIC CMS: HERO PRESIDENT & ABOUT CONTENT
// ==========================================

model PresidentialWelcome {
  id             String                 @id @default(cuid())
  presidentName  String
  officeTitle    String                 @default("Executive President")
  stateOfOrigin  String                 @default("Ekiti State")
  sessionTitle   String                 @default("2026/2027 Progress Era Session")
  portraitUrl    String?
  welcomeSummary String
  fullMessage    String
  isActive       Boolean                @default(true)
  sessionId      String?
  session        AdministrationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([isActive])
}

model AboutContent {
  id           String   @id @default(cuid())
  sectionKey   String   @unique
  title        String
  subtitle     String?
  content      String
  iconName     String?  @default("BookOpen")
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sectionKey])
}

// ==========================================
// 17. ENTERPRISE CONTACT & COMMUNICATION CENTRE
// ==========================================

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

model ContactMessage {
  id           String        @id @default(cuid())
  referenceNo  String        @unique
  fullName     String
  email        String
  phone        String
  institution  String
  state        String
  subject      String
  category     String        @default("GENERAL")
  message      String
  status       MessageStatus @default(UNREAD)
  replyMessage String?
  ipAddress    String?
  createdAt    DateTime      @default(now())
  readAt       DateTime?
  repliedAt    DateTime?

  @@index([status, createdAt])
  @@index([email])
}

model FaqItem {
  id           String   @id @default(cuid())
  question     String
  answer       String
  category     String   @default("GENERAL")
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, displayOrder])
}

// ==========================================
// 18. ENTERPRISE STUDENT REGISTRATION & MEMBERSHIP DATABASE
// ==========================================

enum RegistrationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model StudentRegistration {
  id                            String             @id @default(cuid())
  regNumber                     String             @unique
  fullName                      String
  gender                        String             @default("MALE")
  dateOfBirth                   DateTime?
  birthMonth                    String?
  birthDay                      String?
  passportUrl                   String?
  matricNumber                  String             @unique
  jambRegNumber                 String?
  faculty                       String
  department                    String
  programme                     String             @default("B.Sc.")
  level                         String             @default("100L")
  phone                         String             @unique
  whatsapp                      String?
  email                         String             @unique
  stateOfOrigin                 String
  lga                           String
  homeTown                      String
  residenceType                 String             @default("On-Campus")
  hallOfResidence               String?
  roomNumber                    String?
  residentialAddress            String?
  areaCouncil                   String             @default("Federal University Dutse Main Campus")
  membershipCategory            String             @default("Undergraduate")
  emergencyContactName          String
  emergencyContactRelationship  String
  emergencyContactPhone         String
  status                        RegistrationStatus @default(PENDING)
  notes                         String?
  ipAddress                     String?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([stateOfOrigin, faculty, level])
  @@index([matricNumber, email, phone])
}

// ==========================================
// 19. CONTROLLED MEMBERSHIP REGISTRATION WINDOW
// ==========================================

model RegistrationSettings {
  id               String    @id @default(cuid())
  registrationOpen Boolean   @default(true)
  opensAt          DateTime?
  closesAt         DateTime?
  notice           String?
  closedMessage    String?
  academicSession  String?   @default("2026/2027")
  updatedAt        DateTime  @updatedAt
}



